{
  "name": "surakshyapath",
  "version": "1.1.0",
  "description": "SurakshyaPath — reproducible incident analysis, explainable risk modelling, patrol routing, and resource-allocation research.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "local": "node scripts/local.js",
    "test": "node --test test/*.test.js",
    "research": "node experiments/run-research.js",
    "research-experiments": "node experiments/run-experiments.js",
    "patrol-experiments": "node experiments/run-patrol-experiments.js",
    "allocation-experiments": "node experiments/run-allocation-experiments.js",
    "validate": "node scripts/validate.js",
    "robustness-experiments": "node experiments/run-robustness-experiments.js",
    "figures": "node experiments/generate-figures.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": { "express": "^4.19.2" },
  "license": "MIT"
}
